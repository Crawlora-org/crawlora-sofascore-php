{
  "name": "crawlora/sofascore",
  "description": "SofaScore client for the Crawlora hosted API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Sofascore\\": "src/Crawlora/Sofascore/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Sofascore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://github.com/Crawlora-org/crawlora-sofascore",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-sofascore"
  }
}
